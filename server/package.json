{
    "name": "collaborative-editor-server",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "db:init": "node scripts/initDb.js",
        "hocuspocus": "node scripts/startHocuspocus.js",
        "dev:hocuspocus": "nodemon scripts/startHocuspocus.js",
        "scan:unused": "knip",
        "scan:deps": "depcheck",
        "scan:cycles": "madge --circular --extensions js .",
        "scan:dup": "jscpd . --min-lines 10 --min-tokens 50",
        "scan:all": "npm run scan:unused && npm run scan:deps && npm run scan:cycles && npm run scan:dup"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "Backend for a real-time collaborative document editor.",
    "dependencies": {
        "@hocuspocus/extension-database": "^3.4.3",
        "@hocuspocus/server": "^3.4.3",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "express-validator": "^7.3.2",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.21.0",
        "pino": "^9.7.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "yjs": "^13.6.31"
    },
    "devDependencies": {
        "depcheck": "^1.4.7",
        "jscpd": "^4.2.4",
        "knip": "^6.14.2",
        "madge": "^8.0.0",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3"
    }
}
